# ==============================================================================
# REMOTE JOB HUNTER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Evaluation Key (Google Gemini API — free tier available at ai.google.dev)
GOOGLE_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Scoring Threshold (0.0 to 10.0 — jobs scored >= this threshold trigger alerts)
MIN_SCORE_THRESHOLD="7.5"

# Discord Alerts (Optional but recommended — create a channel webhook in Discord)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"
DISCORD_BOT_TOKEN="your_optional_discord_bot_token"

# Applicant Profile (Used by Gemini for fit scoring and custom pitch generation)
APPLICANT_NAME="Alex Mercer"
APPLICANT_LOCATION="Remote (Europe / US Timezones)"
APPLICANT_EMAIL="alex.mercer@example.com"
APPLICANT_PHONE="+1 555 123 4567"
APPLICANT_PORTFOLIO="https://alex-mercer.dev"
APPLICANT_GITHUB="https://github.com/alex-mercer"
APPLICANT_LINKEDIN="https://linkedin.com/in/alex-mercer"
APPLICANT_TITLE="AI & Automation Builder · Operations & GTM Systems"
APPLICANT_KEY_METRICS="Built 30+ production automation workflows saving 300+ hrs/mo"
APPLICANT_STACK="n8n, Python, LLM APIs (OpenAI/Anthropic/Gemini), REST APIs, Webhooks, CRM, PostgreSQL"
APPLICANT_LANGUAGES="English (Fluent), French (Native)"
APPLICANT_HIGHLIGHT="Proven builder of resilient event-driven automations, AI agents, and lead qualification engines."

# Local Server Settings
COMMAND_CENTER_PORT="5070"
COMMAND_CENTER_HOST="127.0.0.1"
